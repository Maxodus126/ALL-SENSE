                                        <Border Width="62" Height="62" CornerRadius="14" Background="{StaticResource RedGradient}" BorderBrush="#33FFFFFF" BorderThickness="1">
                                            <Path Data="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M4.5 12h3l1.5-4 2 8 1.5-6 1 2h4.5"
                                                  Stroke="#2A0008" StrokeThickness="1.8" Stretch="Uniform" Margin="14" StrokeLineJoin="Round"/>
                                        </Border>
                                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="18" FontWeight="Bold" Text="AllSense Control"/>
                                            <TextBlock x:Name="AboutVer" FontSize="12.5" Foreground="{StaticResource Txt3}" Margin="0,3,0,0" Text="v1.2.0 · Universal laptop control center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardLabel}" Foreground="{StaticResource Blueprint}" Text="TEKNIS"/>
                                        <Grid Margin="0,10,0,0"><TextBlock Foreground="{StaticResource Txt2}" FontSize="12.5" Text="Framework"/><TextBlock HorizontalAlignment="Right" FontSize="12" Text=".NET 8 + WPF"/></Grid>
                                        <Grid Margin="0,10,0,0"><TextBlock Foreground="{StaticResource Txt2}" FontSize="12.5" Text="Target OS"/><TextBlock HorizontalAlignment="Right" FontSize="12" Text="Windows 11 x64"/></Grid>
                                        <Grid Margin="0,10,0,0"><TextBlock Foreground="{StaticResource Txt2}" FontSize="12.5" Text="Sumber daya"/><TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Green}" Text="Local-first"/></Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardLabel}" Foreground="{StaticResource Green}" Text="PRIVASI"/>
                                    <TextBlock FontSize="13" Foreground="{StaticResource Txt2}" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,0"
                                               Text="Semua data diproses lokal di perangkat. Tanpa telemetri, tanpa cloud, tanpa akun. AllSense hanya membaca status daya dan sensor sistem."/>
                                </StackPanel>
                            </Border>
                            <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource Txt3}" Margin="0,30,0,0"
                                       Text="AllSense Control © 2026 — dibangun untuk Windows 11 · Precision Instrument Console"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
