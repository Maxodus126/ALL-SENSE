<Window x:Class="AllSense.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AllSense.App"
        Title="AllSense Control"
        Width="1180" Height="780" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI" Foreground="{StaticResource Txt}">

    <Grid>

        <!-- glow latar -->
        <Rectangle Fill="{StaticResource RedGlow}" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource CyanGlow}" IsHitTestVisible="False"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ RAIL / SIDEBAR ============ -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceGradient}"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>

                    <!-- Brand -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,22,18,18">
                        <Border Width="34" Height="34" CornerRadius="9"
                                Background="{StaticResource RedGradient}"
                                BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,0,12,0">
                            <Path Data="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z
                                      M4.5 12h3l1.5-4 2 8 1.5-6 1 2h4.5"
                                  Stroke="#2A0008" StrokeThickness="1.8" Stretch="Uniform"
                                  Margin="7" StrokeLineJoin="Round"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="17" FontWeight="Bold">
                                <Run Text="ALL"/><Run Text="SENSE" Foreground="{StaticResource Red}"/>
                            </TextBlock>
                            <TextBlock FontSize="9.5" Foreground="{StaticResource Txt3}"
                                       Text="CONTROL · CONSOLE"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Nav -->
                    <ListBox x:Name="NavList" DockPanel.Dock="Top"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Padding="10,10,10,14" SelectionChanged="Nav_SelectionChanged"
                             KeyboardNavigation.DirectionalNavigation="Contained">

                        <ListBoxItem Style="{StaticResource NavGroup}" Content="UTAMA"/>

                        <ListBoxItem Style="{StaticResource NavItem}" Tag="dashboard">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"
                                      Stroke="{StaticResource Txt3}" StrokeThickness="1.7" Stretch="Uniform"
                                      Width="18" Height="18" Margin="0,0,12,0" StrokeLineJoin="Round"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource NavItem}" Tag="power">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 3v9M6.5 6.5a8 8 0 1 0 11 0"
                                      Stroke="{StaticResource Txt3}" StrokeThickness="1.7" Stretch="Uniform"
                                      Width="18" Height="18" Margin="0,0,12,0" StrokeLineJoin="Round"/>
                                <TextBlock Text="Power Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource NavItem}" Tag="cooling">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 2v20M17.5 5.5l-5.5 5-5.5-5M17.5 18.5l-5.5-5-5.5 5M2.5 8.5l19 7M2.5 15.5l19-7"
                                      Stroke="{StaticResource Txt3}" StrokeThickness="1.7" Stretch="Uniform"
                                      Width="18" Height="18" Margin="0,0,12,0" StrokeLineJoin="Round"/>
                                <TextBlock Text="Cooling" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource NavItem}" Tag="battery">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M2 7h17v10H2z M22 10v4M6 10v4M9.5 10v4M13 10v4"
                                      Stroke="{StaticResource Txt3}" StrokeThickness="1.7" Stretch="Uniform"
                                      Width="18" Height="18" Margin="0,0,12,0" StrokeLineJoin="Round"/>
                                <TextBlock Text="Battery" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource NavGroup}" Content="SISTEM"/>

                        <ListBoxItem Style="{StaticResource NavItem}" Tag="mylaptop">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M4 4h16v12H4z M2 20h20M12 16v4"
                                      Stroke="{StaticResource Txt3}" StrokeThickness="1.7" Stretch="Uniform"
                                      Width="18" Height="18" Margin="0,0,12,0" StrokeLineJoin="Round"/>
                                <TextBlock Text="My Laptop" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource NavItem}" Tag="storage">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M5 4h14v16H5z M5 12h14 M9 8h.01 M9 16h.01"
                                      Stroke="{StaticResource Txt3}" StrokeThickness="1.7" Stretch="Uniform"
                                      Width="18" Height="18" Margin="0,0,12,0" StrokeLineJoin="Round"/>
                                <TextBlock Text="Storage" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource NavItem}" Tag="gaming">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M7 10c-2.8 0-5 1.4-5 4s2.2 4 5 4c1.4 0 2.4-.5 3.8-1.8.8-.8 1-1.2 1.2-1.2s.4.4 1.2 1.2C14.6 17.5 15.6 18 17 18c2.8 0 5-1.4 5-4s-2.2-4-5-4z M7.5 13v3M6 14.5h3"
                                      Stroke="{StaticResource Txt3}" StrokeThickness="1.7" Stretch="Uniform"
                                      Width="18" Height="18" Margin="0,0,12,0" StrokeLineJoin="Round"/>
                                <TextBlock Text="Gaming Hub" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource NavGroup}" Content="LAINNYA"/>

                        <ListBoxItem Style="{StaticResource NavItem}" Tag="settings">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z
                                          M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1"
                                      Stroke="{StaticResource Txt3}" StrokeThickness="1.7" Stretch="Uniform"
                                      Width="18" Height="18" Margin="0,0,12,0" StrokeLineJoin="Round"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource NavItem}" Tag="about">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M12 11v5M12 8h.01"
                                      Stroke="{StaticResource Txt3}" StrokeThickness="1.7" Stretch="Uniform"
                                      Width="18" Height="18" Margin="0,0,12,0" StrokeLineJoin="Round"/>
                                <TextBlock Text="About" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!-- footer -->
                    <Border DockPanel.Dock="Bottom" Margin="18,14" BorderBrush="{StaticResource Line}"
                            BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <StackPanel>
                            <TextBlock FontSize="10" Foreground="{StaticResource Txt3}" LineHeight="18">
                                <Run Text="AllSense "/><Run x:Name="VerFoot" Text="v1.2.0" FontWeight="Bold" Foreground="{StaticResource Txt}"/>
                            </TextBlock>
                            <TextBlock FontSize="10" Foreground="{StaticResource Red}" FontFamily="Cascadia Mono, Consolas"
                                       Text="Windows 11 · x64" Margin="0,2,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Green}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock FontSize="10" Foreground="{StaticResource Txt3}" Text="Sistem aktif"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ============ MAIN ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- topbar -->
                <Border Grid.Row="0" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}"
                        BorderThickness="0,0,0,1" Padding="28,14">
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="PgTitle" DockPanel.Dock="Left" FontSize="16"
                                   FontWeight="Bold" VerticalAlignment="Center">
                            <Run Text="DASH"/><Run Text="BOARD" Foreground="{StaticResource Red}"/>
                        </TextBlock>
                        <TextBlock x:Name="PgCrumb" DockPanel.Dock="Left" Margin="14,0,0,0"
                                   VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Txt3}"
                                   Text="Ringkasan sistem"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Border Style="{StaticResource Chip}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Green}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ChipSensor" FontSize="11.5" Foreground="{StaticResource Txt2}" Text="Sensor aktif"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Chip}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource Txt3}" Text="Sumber · "/>
                                    <TextBlock x:Name="ChipSrc" FontSize="11.5" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas" Text="—"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource Txt3}" Text="Jam · "/>
                                    <TextBlock x:Name="ClockText" FontSize="11.5" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas" Text="--:--:--"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="UpBadge" Style="{StaticResource FlatBtn}" Visibility="Collapsed"
                                    Margin="10,0,0,0" Padding="12,6" FontSize="11.5" FontWeight="Bold"
                                    Foreground="{StaticResource Red}" BorderBrush="{StaticResource Red}"
                                    Click="UpBadge_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ContentRoot" MaxWidth="1280" Margin="28,26,28,60">

                        <!-- ========= PAGE: DASHBOARD ========= -->
                        <StackPanel x:Name="PageDash" Visibility="Visible">

                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardLabel}" Foreground="{StaticResource Red}" Text="PERANGKAT"/>
                                        <TextBlock x:Name="HeroModel" FontSize="20" FontWeight="Bold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="HeroSub" FontSize="12.5" Foreground="{StaticResource Txt2}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="20"/>
                                        <Border Margin="0,14,0,0" CornerRadius="7" Padding="13,6" Background="#0F000000"
                                                BorderBrush="#66FF2D4D" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource Red}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="HeroMode" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Red}" Text="Balanced — AC &amp; DC"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Viewbox Grid.Column="1" Width="220" Height="120" Stretch="Uniform">
                                        <Canvas Width="220" Height="120">
                                            <Rectangle Canvas.Left="30" Canvas.Top="8" Width="160" Height="88" RadiusX="8" RadiusY="8"
                                                       Fill="#0B1522" Stroke="#2A3D58"/>
                                            <Rectangle Canvas.Left="34" Canvas.Top="12" Width="152" Height="80" RadiusX="5" RadiusY="5" Fill="#0A111C"/>
                                            <Ellipse Canvas.Left="135" Canvas.Top="43" Width="30" Height="30" Fill="#24FF2D4D"/>
                                            <Ellipse Canvas.Left="57" Canvas.Top="45" Width="26" Height="26" Fill="#1FFF2D4D"/>
                                            <Path Data="M38 68h28l8-22 10 34 8-26 5 14h20" Stroke="#4DD7FF" StrokeThickness="1.6" Opacity="0.8" StrokeLineJoin="Round"/>
                                            <Path Data="M38 76h36l8-16 10 28 8-20 5 12h15" Stroke="#FF2D4D" StrokeThickness="1.6" Opacity="0.7" StrokeLineJoin="Round"/>
                                            <Rectangle Canvas.Left="28" Canvas.Top="100" Width="164" Height="13" RadiusX="4" RadiusY="4" Fill="#131D2C" Stroke="#22334C"/>
                                            <Ellipse Canvas.Left="43.6" Canvas.Top="103.6" Width="4.8" Height="4.8" Fill="#FF5F5F"/>
                                            <Ellipse Canvas.Left="175.6" Canvas.Top="103.6" Width="4.8" Height="4.8" Fill="#3BD29A"/>
                                            <Ellipse Canvas.Left="63" Canvas.Top="19" Width="6" Height="6" Fill="#45C8F0" Opacity="0.9"/>
                                            <Ellipse Canvas.Left="60" Canvas.Top="16" Width="12" Height="12" Stroke="#45C8F0" Opacity="0.3"/>
                                            <Ellipse Canvas.Left="179.6" Canvas.Top="27.6" Width="4.8" Height="4.8" Fill="#FF2D4D" Opacity="0.9"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>

                            <Grid Margin="0,26,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="PEMANTAUAN" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Green}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource Txt3}" Text="LIVE · "/>
                                    <TextBlock x:Name="LiveIv" FontSize="11" Foreground="{StaticResource Red}" FontFamily="Cascadia Mono, Consolas" Text="2 DTK"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                <!-- Mainboard tile -->
                                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,9,0" Padding="14">
                                    <StackPanel>
                                        <Grid><TextBlock Style="{StaticResource CardLabel}" Foreground="{StaticResource Red}" Text="SISTEM"/>
                                              <Border HorizontalAlignment="Right" CornerRadius="5" Padding="7,2" BorderBrush="{StaticResource Line}" BorderThickness="1"><TextBlock FontSize="9" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Txt3}" Text="SUHU SISTEM"/></Border></Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock x:Name="CpuPct" Width="72" FontSize="24" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Red}" VerticalAlignment="Center" Text="—"/>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TileCpuName" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="TileCpuSub" FontSize="11" Foreground="{StaticResource Txt3}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <ProgressBar x:Name="BarCpu" Margin="0,12,0,0" Foreground="{StaticResource Red}" Value="0"/>
                                    </StackPanel>
                                </Border>

                                <!-- GPU tile -->
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,9,0" Padding="14">
                                    <StackPanel>
                                        <Grid><TextBlock Style="{StaticResource CardLabel}" Foreground="{StaticResource Blueprint}" Text="GPU"/>
                                              <Border HorizontalAlignment="Right" CornerRadius="5" Padding="7,2" BorderBrush="{StaticResource Line}" BorderThickness="1"><TextBlock FontSize="9" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Txt3}" Text="CORE TEMP"/></Border></Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock x:Name="GpuPct" Width="72" FontSize="24" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Blueprint}" VerticalAlignment="Center" Text="—"/>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TileGpuName" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="TileGpuSub" FontSize="11" Foreground="{StaticResource Txt3}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <ProgressBar x:Name="BarGpu" Margin="0,12,0,0" Foreground="{StaticResource Blueprint}" Value="0"/>
                                    </StackPanel>
                                </Border>

                                <!-- RAM tile -->
                                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="9,0,9,0" Padding="14">
                                    <StackPanel>
                                        <Grid><TextBlock Style="{StaticResource CardLabel}" Foreground="{StaticResource Green}" Text="RAM"/>
                                              <Border HorizontalAlignment="Right" CornerRadius="5" Padding="7,2" BorderBrush="{StaticResource Line}" BorderThickness="1"><TextBlock FontSize="9" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Txt3}" Text="MEMORI"/></Border></Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <local:RingGauge x:Name="GaugeRam" Width="72" Height="72" Value="0" Accent="{StaticResource Green}"/>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="13" FontWeight="Bold" Text="RAM"/>
                                                <TextBlock x:Name="TileRamSub" FontSize="11" Foreground="{StaticResource Txt3}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <ProgressBar x:Name="BarRam" Margin="0,12,0,0" Foreground="{StaticResource Green}" Value="0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Battery tile -->
                                <Border Grid.Column="3" Style="{StaticResource Card}" Margin="9,0,0,0" Padding="14">
                                    <StackPanel>
                                        <Grid><TextBlock Style="{StaticResource CardLabel}" Foreground="{StaticResource Red}" Text="BATERAI"/>
                                              <Border HorizontalAlignment="Right" CornerRadius="5" Padding="7,2" BorderBrush="{StaticResource Line}" BorderThickness="1"><TextBlock FontSize="9" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Txt3}" Text="DAYA"/></Border></Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <local:RingGauge x:Name="GaugeBat" Width="72" Height="72" Value="0" Accent="{StaticResource Red}"/>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="13" FontWeight="Bold" Text="Baterai" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="TileBatSub" FontSize="11" Foreground="{StaticResource Txt3}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <ProgressBar x:Name="BarBat" Margin="0,12,0,0" Foreground="{StaticResource Red}" Value="0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Power section -->
                            <Grid Margin="0,26,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="POWER MODE" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock FontSize="11" Foreground="{StaticResource Txt3}" Text="Satu klik · AC &amp; DC"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="SegEff" Grid.Column="0" Style="{StaticResource SegBtn}" Tag="eff" Click="Seg_Click" Margin="0,0,6,0">
                                            <Grid>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="4" Padding="6,2" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                                    <TextBlock x:Name="SegEffBadge" FontSize="8.5" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Txt3}" Text="HEMAT"/>
                                                </Border>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource Panel3}" Margin="0,0,12,0">
                                                        <Path Data="M4 20C4 10 10 4 20 4c0 10-6 16-16 16z M4 20c4-4 8-7 12-10"
                                                              Stroke="{StaticResource Txt2}" StrokeThickness="1.7" Stretch="Uniform" Margin="9" StrokeLineJoin="Round"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock FontSize="14" FontWeight="Bold" Text="Efisiensi"/>
                                                        <TextBlock FontSize="10.5" Foreground="{StaticResource Txt3}" Text="Best Power Efficiency"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="SegBal" Grid.Column="1" Style="{StaticResource SegBtn}" Tag="bal" Click="Seg_Click" Margin="6,0,6,0">
                                            <Grid>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="4" Padding="6,2" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                                    <TextBlock x:Name="SegBalBadge" FontSize="8.5" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Txt3}" Text="—"/>
                                                </Border>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource Panel3}" Margin="0,0,12,0">
                                                        <Path Data="M12 3v18M5 21h14M7 6l5-3 5 3M7 6l-3 7a3 3 0 0 0 6 0zM17 6l-3 7a3 3 0 0 0 6 0z"
                                                              Stroke="{StaticResource Txt2}" StrokeThickness="1.7" Stretch="Uniform" Margin="9" StrokeLineJoin="Round"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock FontSize="14" FontWeight="Bold" Text="Balanced"/>
                                                        <TextBlock FontSize="10.5" Foreground="{StaticResource Txt3}" Text="Seimbang · default"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="SegPerf" Grid.Column="2" Style="{StaticResource SegBtn}" Tag="perf" Click="Seg_Click" Margin="6,0,0,0">
                                            <Grid>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="4" Padding="6,2" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                                    <TextBlock x:Name="SegPerfBadge" FontSize="8.5" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Txt3}" Text="MAKS"/>
                                                </Border>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource Panel3}" Margin="0,0,12,0">
                                                        <Path Data="M13 2 4 14h6l-1 8 9-12h-6z"
                                                              Stroke="{StaticResource Txt2}" StrokeThickness="1.7" Stretch="Uniform" Margin="9" StrokeLineJoin="Round"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock FontSize="14" FontWeight="Bold" Text="Performa"/>
                                                        <TextBlock FontSize="10.5" Foreground="{StaticResource Txt3}" Text="Best Performance"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                    <Border Margin="0,12,0,0" CornerRadius="11" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="15,13">
                                        <DockPanel LastChildFill="False">
                                            <CheckBox x:Name="LinkACDC" DockPanel.Dock="Left" IsChecked="False" VerticalAlignment="Center" Checked="Link_Changed" Unchecked="Link_Changed"/>
                                            <TextBlock DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource Txt2}" Text="Gunakan mode yang sama untuk AC &amp; DC"/>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
