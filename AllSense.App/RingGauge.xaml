<UserControl x:Class="AllSense.App.RingGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Ellipse x:Name="TrackEllipse" Stroke="{StaticResource Panel2}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Path x:Name="ProgressPath" Fill="Transparent"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="ValueText" FontFamily="Cascadia Mono, Consolas"
                       FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{StaticResource Txt}"/>
            <TextBlock x:Name="UnitText" FontSize="10" HorizontalAlignment="Center"
                       Margin="0,2,0,0" Foreground="{StaticResource Txt3}"/>
        </StackPanel>
    </Grid>
</UserControl>
